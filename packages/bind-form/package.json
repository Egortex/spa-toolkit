{
	"name": "@chepchik/bind-form",
	"version": "0.2.1",
	"description": "Dependency-free typed form engine: createForm() with types inferred from schema, sync/async/server validation pipeline, automatic server error mapping and built-in accessibility (aria-invalid, focus management). Also exports the original bindForm() helper.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Egortex/spa-toolkit.git",
		"directory": "packages/bind-form"
	},
	"sideEffects": false,
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"test": "tsc --noEmit && vitest run",
		"test:coverage": "tsc --noEmit && vitest run --coverage"
	},
	"keywords": [
		"form",
		"validation",
		"spa",
		"typed-forms",
		"accessibility",
		"form-validation"
	],
	"license": "MIT",
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.0",
		"jsdom": "^30.0.1",
		"vitest": "^5.0.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-dts": "^5.0.2"
	}
}
